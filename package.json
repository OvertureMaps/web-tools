{
  "name": "web-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Public web tools for Overture Maps Foundation data.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/assemble.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
