{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe"],
    "timeout": 30000,
    "wait": 1500,
    "chromeLaunchConfig": { "args": ["--no-sandbox"] }
  },
  "urls": [
    "http://localhost:4173/web-tools/",
    {
      "url": "http://localhost:4173/web-tools/taxonomy-explorer/",
      "hideElements": ".taxonomy-viz-zoom, .taxonomy-viz-center-label, .taxonomy-viz-center-sub"
    },
    {
      "url": "http://localhost:4173/web-tools/taxonomy-explorer/?theme=dark",
      "hideElements": ".taxonomy-viz-zoom, .taxonomy-viz-center-label, .taxonomy-viz-center-sub"
    }
  ]
}
